<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/university#"
     xml:base="http://example.org/university"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#">
    <owl:Ontology rdf:about="http://example.org/university">
        <rdfs:comment xml:lang="ru">лаб2</rdfs:comment>
        <rdfs:label xml:lang="ru">Университет: студенты, преподаватели, курсы</rdfs:label>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->

    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/university#enrolledIn -->

    <owl:ObjectProperty rdf:about="http://example.org/university#enrolledIn">
        <owl:inverseOf rdf:resource="http://example.org/university#hasStudent"/>
        <rdfs:domain rdf:resource="http://example.org/university#Student"/>
        <rdfs:range rdf:resource="http://example.org/university#Course"/>
        <rdfs:label xml:lang="ru">записан на курс</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/university#hasStudent -->

    <owl:ObjectProperty rdf:about="http://example.org/university#hasStudent">
        <rdfs:domain rdf:resource="http://example.org/university#Course"/>
        <rdfs:range rdf:resource="http://example.org/university#Student"/>
        <rdfs:comment xml:lang="ru">Обратное к enrolledIn, заполняется ризонером</rdfs:comment>
        <rdfs:label xml:lang="ru">на курсе учится студент</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/university#studiesTogether -->

    <owl:ObjectProperty rdf:about="http://example.org/university#studiesTogether">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://example.org/university#Student"/>
        <rdfs:range rdf:resource="http://example.org/university#Student"/>
        <rdfs:comment xml:lang="ru">Заполняется только правилом вывода InferClassmates, вручную не задаётся</rdfs:comment>
        <rdfs:label xml:lang="ru">учится вместе с (сокурсник)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/university#studiesWith -->

    <owl:ObjectProperty rdf:about="http://example.org/university#studiesWith">
        <owl:inverseOf rdf:resource="http://example.org/university#teachesStudent"/>
        <rdfs:domain rdf:resource="http://example.org/university#Student"/>
        <rdfs:range rdf:resource="http://example.org/university#Teacher"/>
        <rdfs:comment xml:lang="ru">Заполняется только правилами вывода StudiesByCourse и StudiesBySupervision, вручную не задаётся</rdfs:comment>
        <rdfs:label xml:lang="ru">учится у</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/university#supervisedBy -->

    <owl:ObjectProperty rdf:about="http://example.org/university#supervisedBy">
        <owl:inverseOf rdf:resource="http://example.org/university#supervises"/>
        <rdfs:domain rdf:resource="http://example.org/university#Student"/>
        <rdfs:range rdf:resource="http://example.org/university#Teacher"/>
        <rdfs:comment xml:lang="ru">Обратное к supervises, заполняется ризонером</rdfs:comment>
        <rdfs:label xml:lang="ru">научный руководитель</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/university#supervises -->

    <owl:ObjectProperty rdf:about="http://example.org/university#supervises">
        <rdfs:domain rdf:resource="http://example.org/university#Teacher"/>
        <rdfs:range rdf:resource="http://example.org/university#Student"/>
        <rdfs:label xml:lang="ru">научное руководство студентом</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/university#taughtBy -->

    <owl:ObjectProperty rdf:about="http://example.org/university#taughtBy">
        <owl:inverseOf rdf:resource="http://example.org/university#teaches"/>
        <rdfs:domain rdf:resource="http://example.org/university#Course"/>
        <rdfs:range rdf:resource="http://example.org/university#Teacher"/>
        <rdfs:comment xml:lang="ru">Обратное к teaches, заполняется ризонером</rdfs:comment>
        <rdfs:label xml:lang="ru">курс ведёт преподаватель</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/university#teaches -->

    <owl:ObjectProperty rdf:about="http://example.org/university#teaches">
        <rdfs:domain rdf:resource="http://example.org/university#Teacher"/>
        <rdfs:range rdf:resource="http://example.org/university#Course"/>
        <rdfs:label xml:lang="ru">ведёт курс</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/university#teachesStudent -->

    <owl:ObjectProperty rdf:about="http://example.org/university#teachesStudent">
        <rdfs:domain rdf:resource="http://example.org/university#Teacher"/>
        <rdfs:range rdf:resource="http://example.org/university#Student"/>
        <rdfs:comment xml:lang="ru">Обратное к studiesWith, заполняется ризонером после вывода studiesWith</rdfs:comment>
        <rdfs:label xml:lang="ru">обучает студента</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/university#hasName -->

    <owl:DatatypeProperty rdf:about="http://example.org/university#hasName">
        <rdfs:domain rdf:resource="http://example.org/university#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="ru">имя</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/university#hasTitle -->

    <owl:DatatypeProperty rdf:about="http://example.org/university#hasTitle">
        <rdfs:domain rdf:resource="http://example.org/university#Course"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="ru">название курса</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/university#Course -->

    <owl:Class rdf:about="http://example.org/university#Course">
        <rdfs:label xml:lang="ru">Курс</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/university#Person -->

    <owl:Class rdf:about="http://example.org/university#Person">
        <rdfs:comment xml:lang="ru"></rdfs:comment>
        <rdfs:label xml:lang="ru">Человек</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/university#ResearchStudent -->

    <owl:Class rdf:about="http://example.org/university#ResearchStudent">
        <rdfs:subClassOf rdf:resource="http://example.org/university#Student"/>
        <rdfs:comment xml:lang="ru">Класс заполняется только правилом вывода InferResearchStudent: студент, у которого есть научный руководитель</rdfs:comment>
        <rdfs:label xml:lang="ru">Студент-исследователь</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/university#Student -->

    <owl:Class rdf:about="http://example.org/university#Student">
        <rdfs:subClassOf rdf:resource="http://example.org/university#Person"/>
        <rdfs:label xml:lang="ru">Студент</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/university#Teacher -->

    <owl:Class rdf:about="http://example.org/university#Teacher">
        <rdfs:subClassOf rdf:resource="http://example.org/university#Person"/>
        <rdfs:label xml:lang="ru">Преподаватель</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/university#C1 -->

    <owl:NamedIndividual rdf:about="http://example.org/university#C1">
        <rdf:type rdf:resource="http://example.org/university#Course"/>
        <hasTitle>Онтологический инжиниринг</hasTitle>
        <rdfs:label xml:lang="ru">Онтологический инжиниринг</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://example.org/university#C2 -->

    <owl:NamedIndividual rdf:about="http://example.org/university#C2">
        <rdf:type rdf:resource="http://example.org/university#Course"/>
        <hasTitle>Теория систем</hasTitle>
        <rdfs:label xml:lang="ru">Теория систем</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://example.org/university#S1 -->

    <owl:NamedIndividual rdf:about="http://example.org/university#S1">
        <rdf:type rdf:resource="http://example.org/university#Student"/>
        <enrolledIn rdf:resource="http://example.org/university#C1"/>
        <enrolledIn rdf:resource="http://example.org/university#C2"/>
        <hasName>Иванов И.И.</hasName>
        <rdfs:label xml:lang="ru">Иванов</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://example.org/university#S2 -->

    <owl:NamedIndividual rdf:about="http://example.org/university#S2">
        <rdf:type rdf:resource="http://example.org/university#Student"/>
        <enrolledIn rdf:resource="http://example.org/university#C1"/>
        <hasName>Петрова А.С.</hasName>
        <rdfs:label xml:lang="ru">Петрова</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://example.org/university#S3 -->

    <owl:NamedIndividual rdf:about="http://example.org/university#S3">
        <rdf:type rdf:resource="http://example.org/university#Student"/>
        <enrolledIn rdf:resource="http://example.org/university#C2"/>
        <hasName>Сидоров П.П.</hasName>
        <rdfs:label xml:lang="ru">Сидоров</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://example.org/university#T1 -->

    <owl:NamedIndividual rdf:about="http://example.org/university#T1">
        <rdf:type rdf:resource="http://example.org/university#Teacher"/>
        <supervises rdf:resource="http://example.org/university#S3"/>
        <teaches rdf:resource="http://example.org/university#C1"/>
        <hasName>Смирнов В.А.</hasName>
        <rdfs:label xml:lang="ru">Смирнов</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://example.org/university#T2 -->

    <owl:NamedIndividual rdf:about="http://example.org/university#T2">
        <rdf:type rdf:resource="http://example.org/university#Teacher"/>
        <supervises rdf:resource="http://example.org/university#S1"/>
        <teaches rdf:resource="http://example.org/university#C2"/>
        <hasName>Кузнецова Е.М.</hasName>
        <rdfs:label xml:lang="ru">Кузнецова</rdfs:label>
    </owl:NamedIndividual>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
    </rdf:Description>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // General axioms
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/university#Course"/>
            <rdf:Description rdf:about="http://example.org/university#Student"/>
            <rdf:Description rdf:about="http://example.org/university#Teacher"/>
        </owl:members>
    </rdf:Description>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Rules
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <rdf:Description rdf:about="http://example.org/university#s">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/university#c">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/university#t">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/university#s1">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/university#s2">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/university#n1">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/university#n2">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>Научный руководитель тоже является преподом студента</rdfs:comment>
        <rdfs:label>StudiesBySupervision</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://example.org/university#Teacher"/>
                        <swrl:argument1 rdf:resource="http://example.org/university#t"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                <swrl:classPredicate rdf:resource="http://example.org/university#Student"/>
                                <swrl:argument1 rdf:resource="http://example.org/university#s"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://example.org/university#supervises"/>
                                        <swrl:argument1 rdf:resource="http://example.org/university#t"/>
                                        <swrl:argument2 rdf:resource="http://example.org/university#s"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://example.org/university#studiesWith"/>
                        <swrl:argument1 rdf:resource="http://example.org/university#s"/>
                        <swrl:argument2 rdf:resource="http://example.org/university#t"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>студент с преподом относится к студент-исследователь</rdfs:comment>
        <rdfs:label>InferResearchStudent</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://example.org/university#Student"/>
                        <swrl:argument1 rdf:resource="http://example.org/university#s"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://example.org/university#supervises"/>
                                <swrl:argument1 rdf:resource="http://example.org/university#t"/>
                                <swrl:argument2 rdf:resource="http://example.org/university#s"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://example.org/university#ResearchStudent"/>
                        <swrl:argument1 rdf:resource="http://example.org/university#s"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>Два разных студента одного курса</rdfs:comment>
        <rdfs:label>InferClassmates</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://example.org/university#enrolledIn"/>
                        <swrl:argument1 rdf:resource="http://example.org/university#s1"/>
                        <swrl:argument2 rdf:resource="http://example.org/university#c"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://example.org/university#enrolledIn"/>
                                <swrl:argument1 rdf:resource="http://example.org/university#s2"/>
                                <swrl:argument2 rdf:resource="http://example.org/university#c"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://example.org/university#hasName"/>
                                        <swrl:argument1 rdf:resource="http://example.org/university#s1"/>
                                        <swrl:argument2 rdf:resource="http://example.org/university#n1"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                <swrl:propertyPredicate rdf:resource="http://example.org/university#hasName"/>
                                                <swrl:argument1 rdf:resource="http://example.org/university#s2"/>
                                                <swrl:argument2 rdf:resource="http://example.org/university#n2"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                                        <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#notEqual"/>
                                                        <swrl:arguments rdf:parseType="Collection">
                                                            <rdf:Description rdf:about="http://example.org/university#n1"/>
                                                            <rdf:Description rdf:about="http://example.org/university#n2"/>
                                                        </swrl:arguments>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
