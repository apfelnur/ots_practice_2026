<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns="http://example.org/solar#"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:nodeID="n0b92ee6353dc455e9c5e20ef746a4429b4">
    <rdf:first rdf:resource="http://example.org/solar#Moon"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/solar#hasRadiusKm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/solar#CelestialBody"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="ru">радиус, км</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/solar#Star">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/solar#CelestialBody"/>
    <rdfs:label xml:lang="ru">Звезда</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/solar#Sun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/solar#Star"/>
    <rdfs:label xml:lang="ru">Солнце</rdfs:label>
    <hasName>Солнце</hasName>
    <hasRadiusKm rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">696340</hasRadiusKm>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/solar#Luna">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/solar#Moon"/>
    <rdfs:label xml:lang="ru">Луна</rdfs:label>
    <hasName>Луна</hasName>
    <hasRadiusKm rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1737</hasRadiusKm>
    <orbits rdf:resource="http://example.org/solar#Earth"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/solar#Phobos">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/solar#Moon"/>
    <rdfs:label xml:lang="ru">Фобос</rdfs:label>
    <hasName>Фобос</hasName>
    <hasRadiusKm rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</hasRadiusKm>
    <orbits rdf:resource="http://example.org/solar#Mars"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/solar#Earth">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/solar#Planet"/>
    <rdfs:label xml:lang="ru">Земля</rdfs:label>
    <hasName>Земля</hasName>
    <hasRadiusKm rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6371</hasRadiusKm>
    <orbits rdf:resource="http://example.org/solar#Sun"/>
    <hasMoon rdf:resource="http://example.org/solar#Luna"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/solar#Mars">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/solar#Planet"/>
    <rdfs:label xml:lang="ru">Марс</rdfs:label>
    <hasName>Марс</hasName>
    <hasRadiusKm rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3390</hasRadiusKm>
    <orbits rdf:resource="http://example.org/solar#Sun"/>
    <hasMoon rdf:resource="http://example.org/solar#Phobos"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/solar#hasName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/solar#CelestialBody"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ru">название</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/solar">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="ru">Солнечная система</rdfs:label>
    <rdfs:comment xml:lang="ru">Учебная онтология к лабораторной работе №2</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/solar#CelestialBody">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ru">Небесное тело</rdfs:label>
    <rdfs:comment xml:lang="ru">Общий класс для звёзд, планет и спутников</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/solar#hasMoon">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/solar#Planet"/>
    <rdfs:range rdf:resource="http://example.org/solar#Moon"/>
    <rdfs:label xml:lang="ru">имеет спутник</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/solar#orbits">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/solar#CelestialBody"/>
    <rdfs:range rdf:resource="http://example.org/solar#CelestialBody"/>
    <rdfs:label xml:lang="ru">обращается вокруг</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/solar#Moon">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/solar#CelestialBody"/>
    <rdfs:label xml:lang="ru">Спутник</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0b92ee6353dc455e9c5e20ef746a4429b2">
    <rdf:first rdf:resource="http://example.org/solar#Star"/>
    <rdf:rest rdf:nodeID="n0b92ee6353dc455e9c5e20ef746a4429b3"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0b92ee6353dc455e9c5e20ef746a4429b3">
    <rdf:first rdf:resource="http://example.org/solar#Planet"/>
    <rdf:rest rdf:nodeID="n0b92ee6353dc455e9c5e20ef746a4429b4"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/solar#Planet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/solar#CelestialBody"/>
    <rdfs:label xml:lang="ru">Планета</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0b92ee6353dc455e9c5e20ef746a4429b1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
    <owl:members rdf:nodeID="n0b92ee6353dc455e9c5e20ef746a4429b2"/>
  </rdf:Description>
</rdf:RDF>
